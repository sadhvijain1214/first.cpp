
#include <iostream>
using namespace std;

int main() {
    int pin, choice;
    double balance = 5000, amount;
    int correctPin = 1234;

    cout << "===== ATM SIMULATION =====\n";
    cout << "Enter your PIN: ";
    cin >> pin;

    if (pin != correctPin) {
        cout << "Incorrect PIN!";
        return 0;
    }

    do {
        cout << "\n\n===== ATM MENU =====\n";
        cout << "1. Check Balance\n";
        cout << "2. Withdraw Money\n";
        cout << "3. Deposit Money\n";
        cout << "4. Exit\n";
        cout << "Enter your choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Your balance is: Rs. " << balance;
                break;

            case 2:
                cout << "Enter amount to withdraw: Rs. ";
                cin >> amount;

                if (amount > 0 && amount <= balance) {
                    balance -= amount;
                    cout << "Withdrawal successful!";
                    cout << "\nRemaining balance: Rs. " << balance;
                }
                else {
                    cout << "Invalid amount or insufficient balance!";
                }
                break;

            case 3:
                cout << "Enter amount to deposit: Rs. ";
                cin >> amount;

                if (amount > 0) {
                    balance += amount;
                    cout << "Deposit successful!";
                    cout << "\nUpdated balance: Rs. " << balance;
                }
                else {
                    cout << "Invalid deposit amount!";
                }
                break;

            case 4:
                cout << "Thank you for using our ATM!";
                break;

            default:
                cout << "Invalid choice!";
        }

    } while (choice != 4);

    return 0;
}
